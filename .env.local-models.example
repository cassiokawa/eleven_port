# Fully local setup: Ollama (gemma4:12b) + Kokoro-FastAPI. Copy over .env, then run `npm run doctor -w @eleven-port/api`.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_VISION_MODEL=gemma4:12b

TTS_PROVIDER=local
LOCAL_TTS_URL=http://localhost:8880
LOCAL_TTS_MODEL=kokoro
# Pick any voice listed at http://localhost:8880/docs (or by `npm run doctor`)
LOCAL_TTS_VOICE=af_bella
LOCAL_TTS_FORMAT=mp3

PORT=8787
