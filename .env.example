# --- Cloud providers (default) ---
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Local providers (optional; nothing leaves your machine when all three are local) ---
# Suggestions (tags, collection): LLM_PROVIDER=ollama, uses OLLAMA_MODEL
LLM_PROVIDER=anthropic
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
# OCR with a local vision model (opt-in per client); e.g. a llava or qwen2.5vl tag you have pulled
OLLAMA_VISION_MODEL=
# Narration: TTS_PROVIDER=local needs an OpenAI-compatible /v1/audio/speech server (e.g. Kokoro-FastAPI).
# Ollama itself cannot synthesize speech.
TTS_PROVIDER=elevenlabs
LOCAL_TTS_URL=
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=
LOCAL_TTS_FORMAT=mp3

# --- Server ---
API_TOKEN=
ALLOWED_ORIGINS=
PORT=8787
